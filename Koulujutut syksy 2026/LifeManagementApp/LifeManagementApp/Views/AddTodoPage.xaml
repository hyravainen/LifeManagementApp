<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
             x:Class="LifeManagementApp.Views.AddTodoPage"
             x:DataType="vm:AddTodoViewModel"
             Title="Uusi tehtävä">
    <VerticalStackLayout Padding="20" Spacing="14">
        <Label Text="Otsikko" />
        <Entry Text="{Binding Title}" Placeholder="Mitä pitää tehdä?" />

        <Label Text="Prioriteetti (1–5)" />
        <Picker ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding Priority}" />

        <Label Text="Eräpäivä" />
        <DatePicker Date="{Binding DueDate}" />

        <Label Text="{Binding ErrorMessage}" TextColor="Red" />

        <Button Text="Tallenna" Command="{Binding SaveCommand}" />
    </VerticalStackLayout>
</ContentPage>
